# Leave empty for a same-origin API, such as Cloudflare Pages Functions.
# For GitHub Pages, set this to the HTTPS origin of your separately hosted API.
VITE_API_BASE_URL=

# Optional: your public website URL. For example, https://username.github.io/image-compressor-app/
# GitHub Actions can infer the default GitHub Pages URL when this is not set.
VITE_SITE_URL=
